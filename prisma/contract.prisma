// use prisma-8
// Opaque broker payloads deliberately remain TEXT; runner storage is separate.
enum TaskState {
  QUEUED
  ASSIGNING
  ACCEPTED
  RUNNING
  SUCCEEDED
  FAILED
  HELD
}
enum RunnerState {
  ACCEPTED
  LAUNCHING
  READY
  PROMPT_INTENT
  RUNNING
  SUCCEEDED
  FAILED
  HELD
}
enum DispatchState {
  pending
  failed
  completed
}
model Task {
  id String @id
  data String
  @@map("tasks")
}
model Session {
  id String @id
  data String
  @@map("sessions")
}
model Peer {
  id String @id
  /// @customType(Schema.String.pipe(Schema.brand("OwnerId")))
  owner String
  /// @customType(Schema.String.pipe(Schema.brand("PrincipalId")))
  sender String
  /// @customType(SessionId)
  session String
  /// @customType(Schema.String.pipe(Schema.brand("IncarnationId")))
  incarnation String
  payload String
  /// @customType(Schema.String.pipe(Schema.brand("Hash")))
  fingerprint String
  expires Float
  @@map("peers")
}
model Consent {
  /// @customType(Schema.String.pipe(Schema.brand("OwnerId")))
  owner String
  /// @customType(SessionId)
  session String
  enabled Int
  participants String
  @@id([owner, session])
  @@map("consents")
}
model ParticipantConsent {
  /// @customType(Schema.String.pipe(Schema.brand("OwnerId")))
  owner String
  /// @customType(SessionId)
  session String
  /// @customType(Schema.String.pipe(Schema.brand("PrincipalId")))
  participant String
  enabled Int
  @@id([owner, session, participant])
  @@map("participant_consents")
}
model Archive {
  sequence BigInt @id @default(autoincrement())
  /// @customType(Schema.String.pipe(Schema.brand("OwnerId")))
  owner String
  /// @customType(SessionId)
  session String
  /// @customType(Schema.String.pipe(Schema.brand("ArchiveEntryId")))
  entry String
  /// @customType(Schema.String.pipe(Schema.brand("Hash")))
  digest String
  payload String
  gaps String
  created Float
  @@unique([owner, session, entry, digest])
  @@map("archive")
}
model Evidence {
  id BigInt @id @default(autoincrement())
  /// @customType(TaskId)
  task String
  kind String
  /// @customType(Schema.String.check(Schema.isPattern(/^[a-f0-9]{40}$/)).pipe(Schema.brand("@samuelho/coordinator/Sha")))
  sha String
  /// @customType(Schema.String.pipe(Schema.brand("PrincipalId")))
  principal String
  data String
  observed Float
  @@map("evidence")
}
model DispatchQueue {
  sequence BigInt @id @default(autoincrement())
  id VarChar(255)
  queue VarChar(255)
  payload String
  state DispatchState
  attempts Int @default(0)
  failure String?
  available_at TimestampString(6)
  leased_at TimestampString(6)?
  lease_id Uuid?
  created_at TimestampString(6)
  updated_at TimestampString(6)
  @@unique([id, queue], map: "idx_dispatch_queue_id")
  @@index([sequence, lease_id], map: "idx_dispatch_queue_update")
  @@index([queue, available_at], where: "state = 'pending'", name: "idx_dispatch_queue_take")
  @@map("dispatch_queue")
}
model RecoveryGate {
  id Int @id
  ready Boolean
  @@check(expression: "id = 1", name: "recovery_gate_singleton")
  @@map("recovery_gate")
}
model RunnerTask {
  sequence Int @id @default(autoincrement())
  /// @customType(TaskId)
  taskId String @unique
  /// @customType(Schema.String.pipe(Schema.brand("Hash")))
  fingerprint String
  work String
  worktree String
  state RunnerState
  occupied Int
  /// @customType(Schema.Int.pipe(Schema.brand("ProcessId")))
  pid Int?
  /// @customType(Schema.String.pipe(Schema.brand("IncarnationId")))
  incarnation String
  address String?
  /// @customType(Schema.String.pipe(Schema.brand("AgentSubmissionId")))
  promptId String?
  agentBinding String?
  /// @customType(Schema.String.pipe(Schema.brand("AgentRunId")))
  agentRunId String?
  /// @customType(Schema.Int.pipe(Schema.brand("AgentEventSequence")))
  agentCursor Int @default(0)
  reason String?
  result String?
  detached Int @default(0)
  @@map("runner_tasks")
}
model RunnerEvent {
  seq Int @id @default(autoincrement())
  /// @customType(TaskId)
  taskId String
  payload String
  @@index([taskId, seq])
  @@map("runner_events")
}

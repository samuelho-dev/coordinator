{
  "name": "@samuelho/coordinator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.16"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "check": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/*.test.ts",
    "broker": "tsx src/broker.ts",
    "runner": "tsx src/runner.ts",
    "install:host": "tsx scripts/install.ts",
    "smoke": "tsx scripts/smoke.ts",
    "smoke:hosts": "tsx scripts/host-smoke.ts"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.1",
    "@effect/sql-sqlite-node": "4.0.1",
    "effect": "4.0.1",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@oh-my-pi/pi-coding-agent": "18.6.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "pi": {
    "extensions": [
      "./src/plugin.ts"
    ]
  },
  "omp": {
    "extensions": [
      "./src/plugin.ts"
    ]
  }
}

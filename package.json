{
  "name": "@samuelho-dev/coordinator",
  "version": "0.3.0-beta.12",
  "type": "module",
  "description": "Native agent session inspection and opt-in correlated peer messaging across self-hosted machines",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelho-dev/coordinator.git"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "dist/bin/*/coordinator",
    "dist/plugins/*.js",
    "dist/launch.cjs",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.9.0",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "coordinator": "./dist/launch.cjs"
  },
  "scripts": {
    "build": "go run ./cmd/build",
    "check": "tsc --noEmit",
    "test": "go test ./...",
    "inspector": "go run ./cmd/coordinator inspector",
    "connector": "go run ./cmd/coordinator connector",
    "mcp": "go run ./cmd/coordinator mcp",
    "install:host": "go run ./cmd/coordinator install",
    "smoke": "go run ./cmd/smoke",
    "smoke:package": "go run ./cmd/package-smoke",
    "smoke:deployment": "go run ./cmd/deployment-smoke"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@earendil-works/pi-tui": "1.0.4",
    "@oh-my-pi/pi-coding-agent": "18.6.1",
    "@oh-my-pi/pi-tui": "18.6.1",
    "@types/node": "^24.0.0",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2"
  },
  "pi": {
    "extensions": [
      "./dist/plugins/pi.js"
    ]
  },
  "omp": {
    "extensions": [
      "./dist/plugins/omp.js"
    ]
  }
}

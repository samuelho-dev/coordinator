{
  "name": "@samuelho/coordinator",
  "version": "0.3.0-beta.1",
  "type": "module",
  "description": "Read-only native agent session inspection across self-hosted machines",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samuelho-dev/coordinator.git"
  },
  "keywords": [
    "pi-package"
  ],
  "files": [
    "dist/src/*.js",
    "dist/plugins/*.js",
    "dist/scripts/install.js",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.19"
  },
  "packageManager": "pnpm@11.9.0",
  "exports": {
    "./package.json": "./package.json"
  },
  "bin": {
    "coordinator": "./dist/src/main.js",
    "coordinator-install": "./dist/scripts/install.js"
  },
  "scripts": {
    "build": "effect-tsgo patch --typescript && node scripts/build.ts && tsc -p tsconfig.build.json",
    "check": "tsc --noEmit",
    "test": "vitest run --configLoader native",
    "inspector": "node dist/src/main.js inspector",
    "connector": "node dist/src/main.js connector",
    "mcp": "node dist/src/main.js mcp",
    "install:host": "node dist/scripts/install.js",
    "smoke": "node dist/scripts/smoke.js"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.3",
    "@modelcontextprotocol/client": "2.3.1",
    "effect": "4.0.3"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.4",
    "@effect/tsgo": "0.49.0",
    "@effect/vitest": "4.0.3",
    "@oh-my-pi/pi-coding-agent": "18.6.1",
    "@oh-my-pi/pi-tui": "18.6.1",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "pi": {
    "extensions": [
      "./dist/plugins/pi.js"
    ]
  },
  "omp": {
    "extensions": [
      "./dist/plugins/omp.js"
    ]
  }
}

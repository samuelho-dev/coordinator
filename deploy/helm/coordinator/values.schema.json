{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "sourceSha", "broker", "runner", "persistence"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[^ @\\s]+$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "sourceSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "tls": {
      "type": "object",
      "required": ["existingCaSecret"],
      "properties": {
        "existingCaSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"}
      }
    },
    "broker": {"allOf": [{"$ref": "#/definitions/role"}, {"properties": {"existingSecret": {"minLength": 1}}}]},
    "runner": {
      "allOf": [{"$ref": "#/definitions/role"}],
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}},
      "if": {"properties": {"enabled": {"const": true}}},
      "then": {"properties": {"existingSecret": {"minLength": 1}}}
    },
    "persistence": {
      "type": "object",
      "required": ["backups", "work"],
      "additionalProperties": false,
      "properties": {
        "backups": {"$ref": "#/definitions/storage"},
        "work": {"$ref": "#/definitions/storage"}
      }
    }
  },
  "definitions": {
    "annotations": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "role": {
      "type": "object",
      "required": ["existingSecret", "port", "connectHosts", "extraEnv", "resources"],
      "properties": {
        "existingSecret": {"type": "string", "maxLength": 253, "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "deploymentAnnotations": {"$ref": "#/definitions/annotations"},
        "podAnnotations": {"allOf": [{"$ref": "#/definitions/annotations"}], "properties": {"checksum/values": false}},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "connectHosts": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "extraEnv": {"type": "array", "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "not": {"enum": ["COORDINATOR_CONFIG", "COORDINATOR_IMAGE_SHA", "COORDINATOR_CONNECT_HOSTS_JSON", "COORDINATOR_RUNNER_TOKEN_DIRECTORY", "HOME", "NODE_EXTRA_CA_CERTS"]}}}}},
        "resources": {"type": "object"}
      }
    },
    "storage": {
      "type": "object",
      "required": ["existingClaim", "size", "accessModes"],
      "properties": {
        "existingClaim": {"type": "string", "pattern": "^$|^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$"},
        "size": {"type": "string", "minLength": 1},
        "storageClass": {"type": ["string", "null"]},
        "accessModes": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"enum": ["ReadWriteOnce", "ReadWriteOncePod"]}}
      }
    }
  }
}

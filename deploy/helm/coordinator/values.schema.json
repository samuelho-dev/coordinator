{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "sourceSha", "imagePullSecrets", "nodeSelector", "tolerations", "tls", "inspector", "legacyStorage"],
  "properties": {
    "global": {"type": "object"},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1, "pattern": "^[^@\\s]+$"},
        "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "sourceSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "imagePullSecrets": {
      "type": "array",
      "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"$ref": "#/definitions/name"}}}
    },
    "nodeSelector": {"$ref": "#/definitions/strings"},
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "key": {"type": "string"},
          "operator": {"enum": ["Exists", "Equal"]},
          "value": {"type": "string"},
          "effect": {"enum": ["", "NoSchedule", "PreferNoSchedule", "NoExecute"]},
          "tolerationSeconds": {"type": "integer", "minimum": 0}
        }
      }
    },
    "tls": {
      "type": "object", "additionalProperties": false, "required": ["existingCaSecret"],
      "properties": {"existingCaSecret": {"anyOf": [{"const": ""}, {"$ref": "#/definitions/name"}]}}
    },
    "inspector": {
      "type": "object", "additionalProperties": false,
      "required": ["existingSecret", "port", "deploymentAnnotations", "podAnnotations", "resources"],
      "properties": {
        "existingSecret": {"$ref": "#/definitions/name"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "deploymentAnnotations": {"$ref": "#/definitions/strings"},
        "podAnnotations": {"allOf": [{"$ref": "#/definitions/strings"}], "properties": {"checksum/values": false}},
        "resources": {
          "type": "object", "additionalProperties": false,
          "properties": {"requests": {"$ref": "#/definitions/quantities"}, "limits": {"$ref": "#/definitions/quantities"}}
        }
      }
    },
    "legacyStorage": {
      "type": "object", "additionalProperties": false, "required": ["mode", "claims"],
      "properties": {
        "mode": {"enum": ["fresh", "retain"]},
        "claims": {
          "type": "array",
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["name", "size", "accessModes", "storageClass"],
            "properties": {
              "name": {"$ref": "#/definitions/name"},
              "size": {"type": "string", "minLength": 1},
              "accessModes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["ReadWriteOnce", "ReadOnlyMany", "ReadWriteMany", "ReadWriteOncePod"]}},
              "storageClass": {"type": ["string", "null"]}
            }
          }
        }
      },
      "if": {"properties": {"mode": {"const": "fresh"}}},
      "then": {"properties": {"claims": {"maxItems": 0}}},
      "else": {"properties": {"claims": {"minItems": 1}}}
    }
  },
  "definitions": {
    "name": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"},
    "strings": {"type": "object", "additionalProperties": {"type": "string"}},
    "quantities": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
  }
}
